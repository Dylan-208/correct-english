<Window x:Class="CorrectEnglish.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correct English"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <!-- Margem para o sombreado ter espaco; a janela em si e transparente. -->
  <Border Margin="14"
          CornerRadius="10"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Line}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="7" Direction="270"
                        Opacity="0.20" Color="#FF151A22" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ================= cabecalho ================= -->
      <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
              CornerRadius="9,9,0,0" BorderBrush="{StaticResource Line}"
              BorderThickness="0,0,0,1" Padding="13,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                   Fill="{StaticResource Accent}" />

          <TextBlock Grid.Column="1" Text="Correct English" Margin="8,0,0,0"
                     FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}" VerticalAlignment="Center" />

          <TextBlock x:Name="TargetLabel" Grid.Column="2" Margin="12,0,8,0"
                     FontSize="11" Foreground="{StaticResource Muted}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Right" />

          <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource FlatButton}"
                  Content="&#x2715;" Padding="7,1" FontWeight="Normal" FontSize="11"
                  Background="Transparent" BorderBrush="Transparent"
                  Foreground="{StaticResource Muted}"
                  ToolTip="Fechar (Esc)" Click="OnCloseClick" />
        </Grid>
      </Border>

      <!-- ================= corpo ================= -->
      <Grid Grid.Row="1" Margin="18,16">

        <!-- estado: carregando -->
        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed">
          <TextBlock Style="{StaticResource SectionLabel}" Text="LENDO A SELECAO" />
          <TextBlock x:Name="LoadingText" Style="{StaticResource QuotedText}"
                     Text="Um instante..." />
        </StackPanel>

        <!-- estado: aviso ou erro -->
        <StackPanel x:Name="MessagePanel" Visibility="Collapsed">
          <TextBlock x:Name="MessageLabel" Style="{StaticResource SectionLabel}" Text="AVISO" />
          <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" />
        </StackPanel>

        <!-- estado: resultado -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">

          <StackPanel Margin="0,0,0,15">
            <TextBlock x:Name="OriginalLabel" Style="{StaticResource SectionLabel}"
                       Text="SELECIONADO" />
            <Border BorderBrush="{StaticResource Line}" BorderThickness="2,0,0,0"
                    Padding="11,0,0,0">
              <TextBlock x:Name="OriginalText" Style="{StaticResource QuotedText}" />
            </Border>
          </StackPanel>

          <StackPanel Margin="0,0,0,15">
            <TextBlock Style="{StaticResource SectionLabel}" Text="PORTUGUES" />
            <TextBlock x:Name="TranslationText" Style="{StaticResource BodyText}" />
          </StackPanel>

          <StackPanel Margin="0,0,0,15">
            <TextBlock Style="{StaticResource SectionLabel}" Text="CORRECAO" />
            <Border Background="{StaticResource OkSoft}" CornerRadius="6" Padding="11,8">
              <TextBlock x:Name="CorrectedText" Style="{StaticResource BodyText}"
                         FontSize="14.5" />
            </Border>

            <!-- Tom de voz: existe na tela para o layout ficar honesto com o mockup,
                 mas so passa a fazer algo quando a camada de IA entrar. -->
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0" IsEnabled="False"
                        ToolTip="O seletor de tom chega junto com a camada de IA.">
              <Border Background="{StaticResource Ink}" CornerRadius="99" Padding="9,3">
                <TextBlock Text="Neutro" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Surface}" />
              </Border>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                      CornerRadius="99" Padding="9,3" Margin="6,0,0,0">
                <TextBlock Text="Formal" FontSize="11.5" Foreground="{StaticResource Muted}" />
              </Border>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                      CornerRadius="99" Padding="9,3" Margin="6,0,0,0">
                <TextBlock Text="Informal" FontSize="11.5" Foreground="{StaticResource Muted}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="WhySection">
            <TextBlock Style="{StaticResource SectionLabel}" Text="POR QUE" />
            <ItemsControl x:Name="WhyList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource AccentSoft}"
                            CornerRadius="4" Padding="5,2" VerticalAlignment="Top"
                            Margin="0,1,9,0">
                      <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}"
                                 FontSize="9.5" Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Why}" TextWrapping="Wrap"
                               FontSize="12.8" LineHeight="19"
                               Foreground="{StaticResource InkSoft}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </Grid>

      <!-- ================= rodape ================= -->
      <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
              CornerRadius="0,0,9,9" BorderBrush="{StaticResource Line}"
              BorderThickness="0,1,0,0" Padding="18,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="ReplaceButton" Grid.Column="0"
                  Style="{StaticResource PrimaryButton}" Content="Replace  &#x21B5;"
                  IsDefault="True" Click="OnReplaceClick" />

          <Button x:Name="CopyButton" Grid.Column="1" Margin="8,0,0,0"
                  Style="{StaticResource FlatButton}" Content="Copiar"
                  Click="OnCopyClick" />

          <TextBlock x:Name="EngineLabel" Grid.Column="3" FontSize="11"
                     Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
